# Review build: served under /threats/, idle reset on.
# Images are still local for now. When they go up to the CDN, change
# VITE_IMAGE_BASE to https://assets.digitalgizmo.com/threats — vite.config.js
# notices the absolute URL and stops copying public/ into dist/.
VITE_BASE_URL=/threats-to-whales/
VITE_IMAGE_BASE=/threats-to-whales/images
# Unattended, so it recovers on its own. With no attract screen the idle timer
# only closes an open popup. Seconds; 0 disables.
VITE_IDLE_TIMEOUT=180
